<section class="tab gear-tab {{tab.cssClass}}" data-group="primary" data-tab="gear">
  <section class="panel resource-panel">
    <div class="resource-line">
      <span><strong>{{localize "PENTRA.Trait.resourceDie"}}</strong> {{pentraDie system.resourceDie.value}}</span>
      <button type="button" data-action="resourceUsage"><i class="fa-solid fa-dice"></i> {{localize "PENTRA.Usage.Check"}}</button>
    </div>
    <div class="resource-line">
      <span class="{{#if system.carry.over}}warning{{/if}}"><strong>{{localize "PENTRA.Carry.Slots"}}</strong> {{system.carry.used}} / {{system.carry.max}}</span>
      <span class="hint">{{localize "PENTRA.Carry.Hint"}}</span>
    </div>
  </section>

  {{! Field kits }}
  <section class="item-section">
    <header class="item-header">
      <h3>{{localize "TYPES.Item.fieldkit"}}</h3>
      <span class="col">{{localize "PENTRA.Kit.Usage"}}</span>
      <span class="col">{{localize "PENTRA.Cost"}}</span>
      <span class="controls">
        <a data-action="refreshKits" data-tooltip="{{localize 'PENTRA.Kit.Refresh'}}"><i class="fa-solid fa-arrows-rotate"></i></a>
        {{#if isGM}}<a data-action="itemCreate" data-type="fieldkit"><i class="fa-solid fa-plus"></i></a>{{/if}}
      </span>
    </header>
    <ol class="item-list">
      {{#each items.fieldkit}}
      <li class="item-row draggable" data-item-id="{{id}}">
        <a class="item-name" data-action="itemEdit"><img src="{{img}}" alt=""> {{name}}</a>
        <span class="col">
          <select data-item-field="system.usage" data-dtype="Number">{{selectOptions @root.dice.usage selected=system.usage}}</select>
        </span>
        <span class="col">{{cost}}</span>
        <span class="controls">
          <a data-action="itemUsage" data-tooltip="{{#if isReloading}}{{localize 'PENTRA.Kit.Restock'}}{{else}}{{localize 'PENTRA.Kit.Use'}}{{/if}}"><i class="fa-solid fa-dice"></i></a>
          <a data-action="itemSell" data-tooltip="{{localize 'PENTRA.Sell.Title'}}"><i class="fa-solid fa-coins"></i></a>
          {{#if @root.editable}}<a data-action="itemDelete"><i class="fa-solid fa-trash"></i></a>{{/if}}
        </span>
      </li>
      {{/each}}
    </ol>
  </section>

  {{! Armor }}
  <section class="item-section">
    <header class="item-header">
      <h3>{{localize "TYPES.Item.armor"}}</h3>
      <span class="col narrow">{{localize "PENTRA.Armor.ARShort"}}</span>
      <span class="col narrow">{{localize "PENTRA.Armor.Coverage"}}</span>
      <span class="col">{{localize "PENTRA.Cost"}}</span>
      <span class="controls">{{#if isGM}}<a data-action="itemCreate" data-type="armor" data-tooltip="{{localize 'PENTRA.AddItem'}}"><i class="fa-solid fa-plus"></i></a>{{/if}}</span>
    </header>
    <ol class="item-list">
      {{#each items.armor}}
      <li class="item-row draggable {{#unless system.equipped}}unequipped{{/unless}} {{#if system.isBroken}}broken{{/if}}" data-item-id="{{id}}">
        <a class="item-name" data-action="itemEdit"><img src="{{img}}" alt=""> {{name}}</a>
        <span class="col narrow">{{system.ar}}{{#if system.heavy}}×2{{/if}}</span>
        <span class="col narrow">{{coverage}}</span>
        <span class="col">{{cost}}</span>
        <span class="controls">
          <a data-action="itemToggle" class="{{#if system.equipped}}active{{/if}}" data-tooltip="{{localize 'PENTRA.Worn'}}"><i class="fa-solid fa-shirt"></i></a>
          <a data-action="itemSell" data-tooltip="{{localize 'PENTRA.Sell.Title'}}"><i class="fa-solid fa-coins"></i></a>
          {{#if @root.editable}}<a data-action="itemDelete" data-tooltip="{{localize 'PENTRA.Delete'}}"><i class="fa-solid fa-trash"></i></a>{{/if}}
        </span>
      </li>
      {{else}}
      <li class="empty hint">{{localize "PENTRA.DropHint"}}</li>
      {{/each}}
    </ol>
  </section>

  {{! Weapons }}
  <section class="item-section">
    <header class="item-header">
      <h3>{{localize "TYPES.Item.weapon"}}{{#if weaponCarry}} <span class="carry-summary {{#if weaponCarry.over}}warning{{/if}}" data-tooltip="{{localize 'PENTRA.Weapon.CarryRule'}}">{{weaponCarry.label}}</span>{{/if}}</h3>
      <span class="col">{{localize "PENTRA.Weapon.Damage"}}</span>
      <span class="col">{{localize "PENTRA.Cost"}}</span>
      <span class="col">{{localize "PENTRA.Weapon.Carried"}}</span>
      <span class="controls">{{#if isGM}}<a data-action="itemCreate" data-type="weapon" data-tooltip="{{localize 'PENTRA.AddItem'}}"><i class="fa-solid fa-plus"></i></a>{{/if}}</span>
    </header>
    <ol class="item-list">
      {{#each items.weapon}}
      <li class="item-row draggable {{#unless system.equipped}}unequipped{{/unless}}" data-item-id="{{id}}">
        <a class="item-name" data-action="itemEdit"><img src="{{img}}" alt=""> {{name}}</a>
        <span class="col">{{damage}}</span>
        <span class="col">{{cost}}</span>
        <span class="col"><select class="slot-select slot-{{system.slot}}" data-item-field="system.slot" data-tooltip="{{localize 'PENTRA.Weapon.SlotHint'}}">{{selectOptions @root.weaponSlots selected=system.slot localize=true}}</select></span>
        <span class="controls">
          <a data-action="itemSell" data-tooltip="{{localize 'PENTRA.Sell.Title'}}"><i class="fa-solid fa-coins"></i></a>
          {{#if @root.editable}}<a data-action="itemDelete" data-tooltip="{{localize 'PENTRA.Delete'}}"><i class="fa-solid fa-trash"></i></a>{{/if}}
        </span>
      </li>
      {{else}}
      <li class="empty hint">{{localize "PENTRA.DropHint"}}</li>
      {{/each}}
    </ol>
  </section>

  {{! Vehicles (actors with their own sheet) }}
  <section class="item-section">
    <header class="item-header">
      <h3>{{localize "TYPES.Actor.vehicle"}}</h3>
      <span class="col narrow">{{localize "PENTRA.Vehicle.SpeedShort"}}</span>
      <span class="col">{{localize "PENTRA.Trait.health"}}</span>
      <span class="col">{{localize "PENTRA.Vehicle.Seat"}}</span>
      <span class="controls"></span>
    </header>
    <ol class="item-list">
      {{#each vehicles}}
      <li class="item-row" data-uuid="{{uuid}}">
        <a class="item-name" data-action="openVehicle"><img src="{{img}}" alt=""> {{name}}</a>
        <span class="col narrow">{{system.speedClass}}</span>
        <span class="col"><span class="{{#if damaged}}warning{{/if}}">{{system.health.value}}</span> / {{system.health.max}}</span>
        <span class="col">{{role}}</span>
        <span class="controls">
          <a data-action="openVehicle" data-tooltip="{{localize 'PENTRA.Vehicle.Open'}}"><i class="fa-solid fa-car-side"></i></a>
          {{#if owned}}<a data-action="sellVehicle" data-tooltip="{{localize 'PENTRA.Sell.Title'}}"><i class="fa-solid fa-coins"></i></a>{{/if}}
        </span>
      </li>
      {{else}}
      <li class="empty hint">{{localize "PENTRA.Vehicle.GearHint"}}</li>
      {{/each}}
    </ol>
  </section>

  <p class="hint">{{localize "PENTRA.Purchase.Hint"}}</p>
</section>
