<section class="item-details">
  <div class="form-group">
    <label>{{localize "PENTRA.Disease.Hampers"}}</label>
    <select name="system.effect">{{selectOptions options.diseaseEffects selected=system.effect localize=true}}</select>
  </div>
  {{#if (eq system.effect "attribute")}}
  <div class="form-group">
    <label>{{localize "PENTRA.Attribute.label"}}</label>
    <select name="system.attribute">{{selectOptions options.attributes selected=system.attribute localize=true}}</select>
  </div>
  {{/if}}
  {{#if (eq system.effect "trait")}}
  <div class="form-group">
    <label>{{localize "PENTRA.Modifies"}}</label>
    <select name="system.trait">{{selectOptions options.diseaseTraits selected=system.trait localize=true}}</select>
  </div>
  <div class="form-group">
    <label>{{localize "PENTRA.Disease.DieSteps"}}</label>
    <input type="number" name="system.dieSteps" value="{{system.dieSteps}}" max="0">
  </div>
  {{/if}}
  <div class="form-group">
    <label>{{localize "PENTRA.Disease.Penalty"}}</label>
    <input type="number" name="system.penalty" value="{{system.penalty}}" max="0">
  </div>
  <p class="hint">{{localize "PENTRA.Disease.SheetHint"}}</p>
  {{#if system.summary}}<p><strong>{{localize "PENTRA.Effect"}}:</strong> {{system.summary}}</p>{{/if}}
</section>
