<header class="sheet-header item-sheet-header">
  <img class="profile-img" src="{{item.img}}" data-action="editImage" data-edit="img" alt="{{item.name}}">
  <div class="header-main">
    <input class="item-name" name="name" type="text" value="{{item.name}}" placeholder="{{localize 'PENTRA.Name'}}">
    <span class="item-type">{{typeLabel}}</span>
  </div>
</header>
