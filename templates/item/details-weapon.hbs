<section class="item-details">
  <div class="form-group">
    <label>{{localize "PENTRA.Weapon.Category"}}</label>
    <select name="system.category">{{selectOptions options.weaponCategories selected=system.category localize=true}}</select>
  </div>
  <div class="form-group">
    <label>{{localize "PENTRA.Weapon.Skill"}}</label>
    <select name="system.skill">{{selectOptions options.attackSkills selected=system.skill localize=true}}</select>
  </div>
  <div class="form-group">
    <label>{{localize "PENTRA.Weapon.Damage"}}</label>
    <div class="form-fields">
      <input type="number" name="system.wounds" value="{{system.wounds}}" min="0">
      <span>{{localize "PENTRA.Wounds"}}</span>
      <select name="system.increment">{{selectOptions options.increments selected=system.increment localize=true}}</select>
    </div>
  </div>
  <div class="form-group">
    <label>{{localize "PENTRA.Weapon.Range"}}</label>
    <select name="system.range">{{selectOptions options.ranges selected=system.range localize=true}}</select>
  </div>
  <div class="form-group">
    <label>{{localize "PENTRA.Weapon.Hands"}}</label>
    <select name="system.hands">{{selectOptions options.hands selected=system.hands localize=true}}</select>
  </div>
  <div class="form-group">
    <label>{{localize "PENTRA.Weapon.Heavy"}}</label>
    <input type="checkbox" name="system.heavy" {{checked system.heavy}}>
    <p class="hint">{{localize "PENTRA.Weapon.HeavyHint"}}</p>
  </div>
  <div class="form-group">
    <label>{{localize "PENTRA.Weapon.Burning"}}</label>
    <input type="checkbox" name="system.burning" {{checked system.burning}}>
    <p class="hint">{{localize "PENTRA.Weapon.BurningHint"}}</p>
  </div>
  <div class="form-group">
    <label>{{localize "PENTRA.Underwater.WeaponLabel"}}</label>
    <select name="system.underwater">{{selectOptions options.underwaterModes selected=system.underwater localize=true}}</select>
  </div>
  <div class="form-group">
    <label>{{localize "PENTRA.Weapon.Reload"}}</label>
    <input type="number" name="system.reloadActions" value="{{system.reloadActions}}" min="0">
  </div>
  <div class="form-group">
    <label>{{localize "PENTRA.Weapon.Carried"}}</label>
    <select name="system.slot">{{selectOptions options.weaponSlots selected=system.slot localize=true}}</select>
    <p class="hint">{{localize "PENTRA.Weapon.CarryRule"}}</p>
  </div>
  {{> "systems/pentra-core-foundry-vtt/templates/item/physical.hbs"}}
</section>
