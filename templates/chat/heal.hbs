<div class="pentra chat-card heal-card">
  <header class="card-header"><h3>{{title}}</h3></header>
  <div class="result success">+{{amount}} {{localize "PENTRA.Wounds"}}</div>
  <div class="card-buttons">
    <button type="button" data-pentra-action="apply-healing"><i class="fa-solid fa-kit-medical"></i> {{localize "PENTRA.Medicine.Apply"}}</button>
  </div>
  <p class="hint">{{localize "PENTRA.Medicine.ApplyHint"}}</p>
</div>
